{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shihuiarenjinba-png/data-hub-distribution/blob/main/schema/public-manifest.schema.json",
  "title": "data-Hub Public Sample Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "published_at",
    "entitlement_scope",
    "max_lookback",
    "max_lookback_unit",
    "files",
    "e_stat_candidates_approved",
    "source_generated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "pattern": "^sample-[0-9]{8}T[0-9]{6}Z$" },
    "published_at": { "type": "string", "format": "date-time" },
    "entitlement_scope": { "const": "public_sample" },
    "max_lookback": { "const": 3 },
    "max_lookback_unit": {
      "const": "calendar_months_anchored_per_series_to_actual_latest_observation"
    },
    "source_generated_at": { "type": ["string", "null"] },
    "e_stat_candidates_approved": { "const": false },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official-bundle.json",
        "us-official-series.csv",
        "jp-estat-candidates.csv"
      ],
      "properties": {
        "official-bundle.json": { "$ref": "#/$defs/file" },
        "us-official-series.csv": { "$ref": "#/$defs/file" },
        "jp-estat-candidates.csv": { "$ref": "#/$defs/file" }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "version",
        "published_at",
        "available_from",
        "available_through",
        "frequency",
        "source",
        "unit",
        "seasonal_adjustment",
        "observation_count",
        "byte_size",
        "sha256",
        "content_type",
        "entitlement_scope",
        "data_status",
        "url"
      ],
      "properties": {
        "dataset_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" },
        "available_from": { "type": ["string", "null"], "format": "date" },
        "available_through": { "type": ["string", "null"], "format": "date" },
        "frequency": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "seasonal_adjustment": { "type": "string", "minLength": 1 },
        "observation_count": { "type": "integer", "minimum": 0 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content_type": { "type": "string", "minLength": 1 },
        "entitlement_scope": { "const": "public_sample" },
        "data_status": {
          "enum": ["verified", "candidate_unapproved"]
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/shihuiarenjinba-png/data-hub-distribution/releases/download/sample-[0-9]{8}T[0-9]{6}Z/"
        }
      }
    }
  }
}
